{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "**/src/routeTree.gen.ts",
    "**/auth-schema.ts",
    "**/drizzle/**",
    "apps/docs/.source/**",
    "apps/docs/public/**",
    "apps/docs/src/components/ui/**",
    "examples/*/src/components/ui/**"
  ],
  "rules": {
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "typescript/no-invalid-void-type": "error",
    "typescript/no-dynamic-delete": "error",
    "typescript/no-import-type-side-effects": "error",
    "unicorn/error-message": "error",
    "unicorn/throw-new-error": "error",
    "eslint/no-param-reassign": "error",
    "eslint/prefer-const": "error",
    "eslint/prefer-object-has-own": "error",
    "eslint/no-alert": "error",
    "eslint/no-script-url": "error",
    "unicorn/no-document-cookie": "error",
    "eslint/object-shorthand": "error",
    "eslint/prefer-template": "error",
    "eslint/logical-assignment-operators": "error",
    "unicorn/numeric-separators-style": "error",
    "unicorn/prefer-string-raw": "error",
    "unicorn/prefer-structured-clone": "error",
    "unicorn/prefer-response-static-json": "error",
    "unicorn/prefer-optional-catch-binding": "error",
    "unicorn/text-encoding-identifier-case": "error",
    "oxc/no-map-spread": "error",
    "oxc/no-barrel-file": "error",
    "unicorn/no-useless-fallback-in-spread": "off",
    "eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "unicorn/no-empty-file": "off",
    "unicorn/no-useless-spread": "off",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/no-base-to-string": "error",
    "typescript/consistent-return": "error",
    "typescript/no-unnecessary-type-parameters": "error",
    "typescript/no-misused-spread": "error",
    "typescript/require-array-sort-compare": "error",
    "typescript/unbound-method": "error",
    "eslint/no-shadow": "error",
    // Better Auth UI plugin hooks, TanStack Router splat params, and the
    // CommonJS __dirname global use leading underscores by design.
    "eslint/no-underscore-dangle": [
      "error",
      {
        "allow": [
          "_localizationResolver",
          "_localizationOverrides",
          "_splat",
          "__dirname"
        ]
      }
    ],
    // Still off: 59 findings need each nested helper moved by hand.
    "unicorn/consistent-function-scoping": "off",
    // The packages build for Vite's baseline-widely-available target, which
    // includes Firefox 114. It lacks toSorted() and toReversed().
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/prefer-add-event-listener": "error",
    // CSS entry points and the jest-dom matcher setup are side-effect imports.
    "import/no-unassigned-import": [
      "error",
      { "allow": ["**/*.css", "@testing-library/jest-dom/vitest"] }
    ],
    "import/no-named-as-default": "error",
    "import/namespace": "error",
    // Effects start promise chains that end in a side effect.
    "promise/always-return": ["error", { "ignoreLastCallback": true }],
    "vitest/require-mock-type-parameters": "error",
    // Still off: 68 findings in table-driven tests need the cases split.
    "vitest/no-conditional-expect": "off",
    // Vitest's expect accepts a custom message as its second argument.
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],
    "vitest/require-to-throw-message": "error",
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": [
          "expect",
          "expectTypeOf",
          "assertType",
          "expectAligned"
        ]
      }
    ],
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-boolean-literal-compare": "error",
    "import/no-empty-named-blocks": "error",
    "unicorn/require-module-specifiers": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/return-await": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/prefer-optional-chain": "error",
    // TanStack Router control flow throws redirect() and notFound() objects.
    "typescript/only-throw-error": [
      "error",
      {
        "allow": [
          {
            "from": "package",
            "package": "@tanstack/router-core",
            "name": ["Redirect", "NotFoundError"]
          }
        ]
      }
    ],
    "typescript/no-deprecated": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/consistent-type-exports": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-explicit-any": "error",
    "eslint/array-callback-return": "error",
    "eslint/no-throw-literal": "error",
    "eslint/no-self-compare": "error",
    "eslint/no-fallthrough": "error",
    "eslint/no-loop-func": "error",
    "eslint/no-promise-executor-return": "error",
    "eslint/eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    // UI components log the original error before showing a localized toast.
    "eslint/no-console": [
      "error",
      {
        "allow": ["error"]
      }
    ],
    "eslint/no-await-in-loop": "off",
    "import/no-duplicates": "error",
    "import/no-cycle": ["error", { "ignoreTypes": true }],
    "promise/catch-or-return": ["error", { "allowThen": true }],
    "unicorn/prefer-at": "error",
    "unicorn/prefer-string-replace-all": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-top-level-await": "error",
    "unicorn/no-abusive-eslint-disable": "error",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": "allow-with-description",
        "ts-ignore": true,
        "ts-nocheck": true,
        "ts-check": false,
        "minimumDescriptionLength": 10
      }
    ],
    "typescript/prefer-ts-expect-error": "error",
    "unicorn/prefer-set-has": "error",
    "unicorn/prefer-array-find": "error",
    "unicorn/prefer-array-flat-map": "error",
    "eslint/no-useless-call": "error",
    "oxc/no-accumulating-spread": "error",
    "typescript/no-unnecessary-type-arguments": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/no-unnecessary-template-expression": "error",
    "typescript/prefer-reduce-type-parameter": "error",
    "typescript/prefer-readonly": "error",
    "typescript/no-useless-empty-export": "error",
    // `while (true)` loops page through results until a break.
    "typescript/no-unnecessary-condition": [
      "error",
      { "allowConstantLoopConditions": "only-allowed-literals" }
    ],
    // String and boolean `||` is intended: empty strings fall back to a
    // default label, and boolean flags combine. Mixed `a || b && c`
    // expressions are truthiness tests.
    "typescript/prefer-nullish-coalescing": [
      "error",
      {
        "ignorePrimitives": { "string": true, "boolean": true },
        "ignoreMixedLogicalExpressions": true
      }
    ],
    "typescript/require-await": "error",
    "typescript/no-non-null-assertion": "error",
    // Pedantic rules that only measure size, encode an opinion, or duplicate
    // other configured rules stay off.
    "typescript/prefer-readonly-parameter-types": "off",
    "eslint/max-lines": "off",
    "eslint/max-lines-per-function": "off",
    "eslint/max-depth": "off",
    "eslint/max-nested-callbacks": "off",
    "eslint/max-classes-per-file": "off",
    "import/max-dependencies": "off",
    "eslint/no-inline-comments": "off",
    "eslint/no-warning-comments": "off",
    "eslint/no-negated-condition": "off",
    "unicorn/no-negated-condition": "off",
    // typescript/require-await covers this with type information.
    "eslint/require-await": "off",
    // Conflicts with the prefer-nullish-coalescing ignorePrimitives setup.
    "typescript/strict-boolean-expressions": "off",
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/array-type": "error",
    "typescript/no-inferrable-types": "error",
    "typescript/prefer-function-type": "error",
    "typescript/consistent-indexed-object-style": "error",
    "unicorn/switch-case-braces": "error",
    "eslint/no-useless-assignment": "error",
    // typescript/consistent-return needs the explicit `return undefined` in
    // functions that return a value on other paths, and this rule has no
    // option to allow it.
    "unicorn/no-useless-undefined": "off",
    // switch-exhaustiveness-check needs the explicit case before a default,
    // and consistent-return needs the default.
    "unicorn/no-useless-switch-case": "off",
    // Table-driven tests branch on case fields, and the rule also reports
    // && and ?: in filter callbacks. vitest/no-conditional-expect stays off
    // for the same reason.
    "vitest/no-conditional-in-test": "off"
  },
  "overrides": [
    {
      // Published packages declare the return types of their exports.
      "files": ["packages/*/src/**"],
      "rules": {
        "typescript/explicit-module-boundary-types": "error"
      }
    },
    {
      // Hooks, query and mutation option factories, and these helpers return
      // TanStack Query, TanStack Table, or object types that are inferred from
      // Better Auth endpoints. Writing them out would copy large structural
      // types that drift with Better Auth, so they stay inferred.
      "files": [
        "packages/*/src/**/hooks/**",
        "packages/*/src/**/mutations/**",
        "packages/*/src/**/queries/**",
        "packages/*/src/**/*-mutation.ts",
        "packages/*/src/**/*-mutations.ts",
        "packages/*/src/**/*-query.ts",
        "packages/*/src/**/*-queries.ts",
        "packages/*/src/**/*-options.ts",
        "packages/core/src/lib/auth-query-retry.ts",
        "packages/core/src/lib/create-auth-plugin.ts",
        "packages/core/src/lib/table-state.ts",
        "packages/core/src/plugins/dash/dash-audit-log.ts",
        "packages/core/src/plugins/organization/organization-roles.ts",
        "packages/heroui/src/components/auth/auth-form.tsx",
        "packages/heroui/src/components/auth/organization/organization-sortable-table-header.tsx",
        "packages/heroui/src/components/auth/organization/organization-table-state.ts",
        "packages/heroui/src/components/auth/server-table-state.ts",
        "packages/heroui/src/lib/auth/use-resend-cooldown.ts",
        "packages/heroui/src/lib/auth/use-two-factor-password.ts",
        "packages/react-native/src/components/auth/auth-form.tsx",
        "packages/react-native/src/components/auth/organization/list-tools.tsx",
        "packages/react-native/src/components/auth/organization/organization-table-state.ts",
        "packages/react-native/src/components/auth/organization/role-picker.tsx",
        "packages/react-native/src/components/auth/organization/slug-field.tsx",
        "packages/react-native/src/components/auth/organization/use-all-members.ts",
        "packages/react-native/src/components/auth/password-field.tsx",
        "packages/react-native/src/components/auth/server-table-state.ts",
        "packages/react-native/src/lib/auth/use-native-authenticate.ts",
        "packages/react-native/src/lib/auth/use-resend-cooldown.ts",
        "packages/react-native/src/lib/auth/use-two-factor-password.ts",
        "packages/react-native/src/lib/native-locale.tsx",
        "packages/react-native/src/lib/theme-colors.tsx",
        "packages/react-native/src/navigation/organization-plugins.ts",
        "packages/react-native/src/navigation/route-config.ts",
        "packages/react/src/lib/provider-icons.ts",
        "packages/react/src/plugins/agent-auth/index.ts",
        "packages/react/src/plugins/billing/index.ts",
        "packages/react/src/plugins/siwe/index.ts",
        "packages/solid/src/plugins/agent-auth/index.ts",
        "packages/solid/src/plugins/billing/index.ts",
        "packages/solid/src/plugins/siwe/index.ts"
      ],
      "rules": {
        "typescript/explicit-module-boundary-types": "off"
      }
    },
    {
      // Vendored Nx agent skill scripts and the CommonJS Babel config are
      // plain JavaScript without type information. The vendored scripts keep
      // the upstream parseInt calls.
      "files": [".github/skills/**", "examples/expo-example/babel.config.js"],
      "rules": {
        "unicorn/prefer-number-coercion": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off"
      }
    },
    {
      "files": ["apps/docs/**"],
      "jsPlugins": ["eslint-plugin-better-tailwindcss"],
      "rules": {
        "better-tailwindcss/no-conflicting-classes": [
          "error",
          { "entryPoint": "apps/docs/src/styles/shadcn.css" }
        ],
        "better-tailwindcss/no-duplicate-classes": [
          "error",
