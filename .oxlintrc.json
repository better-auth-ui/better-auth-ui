        ],
        "better-tailwindcss/no-unknown-classes": [
          "error",
          {
            "entryPoint": "apps/docs/src/styles/shadcn.css",
            // docs-*, home-*, agent-prompt-* and the preview classes are
            // plain CSS classes from src/styles. not-prose comes from the
            // Fumadocs typography preset. border-separator is a HeroUI token
