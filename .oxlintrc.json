          "error",
          {
            "entryPoint": "examples/start-heroui-example/src/styles/app.css"
          }
        ]
      }
    },
    {
      "files": ["examples/start-shadcn-aria-example/**"],
      "jsPlugins": ["eslint-plugin-better-tailwindcss"],
      "rules": {
        "better-tailwindcss/no-conflicting-classes": [
          "error",
          {
            "entryPoint": "examples/start-shadcn-aria-example/src/styles/app.css"
          }
        ],
        "better-tailwindcss/no-duplicate-classes": [
          "error",
          {
            "entryPoint": "examples/start-shadcn-aria-example/src/styles/app.css"
          }
        ],
        "better-tailwindcss/no-deprecated-classes": [
