{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "**/src/routeTree.gen.ts",
    "**/auth-schema.ts",
    "**/drizzle/**",
    "apps/docs/.source/**",
    "apps/docs/public/**",
    "apps/docs/src/components/ui/**",
    "examples/*/src/components/ui/**"
  ],
  "rules": {
    "unicorn/no-useless-fallback-in-spread": "off",
    "eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "unicorn/no-empty-file": "off",
    "unicorn/no-useless-spread": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-redundant-type-constituents": "off",
    "typescript/no-base-to-string": "off",
    "typescript/consistent-return": "off",
    "typescript/no-unnecessary-type-parameters": "off",
    "typescript/no-misused-spread": "off",
    "typescript/require-array-sort-compare": "off",
    "typescript/unbound-method": "off",
    "eslint/no-shadow": "off",
    "eslint/no-underscore-dangle": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/prefer-add-event-listener": "off",
    "import/no-unassigned-import": "off",
    "import/no-named-as-default": "off",
    "import/namespace": "off",
    "promise/always-return": "off",
    "vitest/require-mock-type-parameters": "off",
    "vitest/no-conditional-expect": "off",
    "vitest/valid-expect": "off",
    "vitest/require-to-throw-message": "off",
    "vitest/expect-expect": "off",
    "typescript/no-unnecessary-type-assertion": "off",
    "typescript/no-unnecessary-boolean-literal-compare": "off",
    "import/no-empty-named-blocks": "off",
    "unicorn/require-module-specifiers": "off",
    "typescript/restrict-plus-operands": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/return-await": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/prefer-optional-chain": "error",
    // TanStack Router control flow throws redirect() and notFound() objects.
    "typescript/only-throw-error": [
      "error",
      {
        "allow": [
          {
            "from": "package",
            "package": "@tanstack/router-core",
            "name": ["Redirect", "NotFoundError"]
          }
        ]
      }
    ],
    "typescript/no-deprecated": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/consistent-type-exports": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-explicit-any": "error",
    "eslint/array-callback-return": "error",
    "eslint/no-throw-literal": "error",
    "eslint/no-self-compare": "error",
    "eslint/no-fallthrough": "error",
    "eslint/no-loop-func": "error",
    "eslint/no-promise-executor-return": "error",
    "eslint/eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    // UI components log the original error before showing a localized toast.
    "eslint/no-console": [
      "error",
      {
        "allow": ["error"]
      }
    ],
    "eslint/no-await-in-loop": "off",
    "import/no-duplicates": "error",
    "import/no-cycle": "error",
    "promise/catch-or-return": "error",
    "unicorn/prefer-at": "error",
    "unicorn/prefer-string-replace-all": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-top-level-await": "error"
  },
  "overrides": [
    {
      "files": ["packages/solid/**", "examples/start-solid-zaidan-example/**"],
      "rules": {
        "eslint/no-unassigned-vars": "off"
      }
    },
    {
      "files": [
        "apps/docs/**",
        "apps/heroui-dev/**",
        "packages/react/**",
        "packages/heroui/**",
        "examples/start-shadcn-example/**",
        "examples/start-shadcn-baseui-example/**",
        "examples/start-heroui-example/**"
      ],
      "plugins": ["react", "jsx-a11y"],
      "rules": {
        "react/react-in-jsx-scope": "off",
        "react/set-state-in-effect": "off",
        "react-hooks/exhaustive-deps": "off",
        "react/immutability": "off",
        "react/refs": "off",
        "react/globals": "off",
        "react/preserve-manual-memoization": "off",
        "react/static-components": "off",
        "react/exhaustive-effect-dependencies": "off",
        "react/hooks": "off",
        "react/no-unstable-nested-components": "off",
        "react/iframe-missing-sandbox": "off",
        "jsx-a11y/no-autofocus": "off",
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/anchor-has-content": "off",
        "jsx-a11y/no-noninteractive-tabindex": "off",
        "jsx-a11y/control-has-associated-label": "off",
        "jsx-a11y/aria-role": [
          "error",
          {
            "ignoreNonDOM": true
          }
        ],
        "react/jsx-no-target-blank": "error",
        "react/button-has-type": "error",
        "react/no-danger": "error",
        "react/jsx-no-useless-fragment": "error",
        "react/no-unknown-property": "error",
        "react/only-export-components": [
          "error",
          {
            "allowConstantExport": true
          }
        ]
      }
    },
    {
      "files": [
        "examples/next-heroui-example/**",
        "examples/next-shadcn-example/**"
      ],
      "plugins": ["react", "jsx-a11y", "nextjs"],
      "rules": {
        "react/react-in-jsx-scope": "off",
        "react/set-state-in-effect": "off",
        "react-hooks/exhaustive-deps": "off",
        "react/immutability": "off",
        "react/refs": "off",
        "react/globals": "off",
        "react/preserve-manual-memoization": "off",
        "react/static-components": "off",
        "react/exhaustive-effect-dependencies": "off",
        "react/hooks": "off",
        "react/no-unstable-nested-components": "off",
        "react/iframe-missing-sandbox": "off",
        "jsx-a11y/no-autofocus": "off",
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/anchor-has-content": "off",
        "jsx-a11y/no-noninteractive-tabindex": "off",
        "jsx-a11y/control-has-associated-label": "off",
        "jsx-a11y/aria-role": [
          "error",
          {
            "ignoreNonDOM": true
          }
        ],
        "react/jsx-no-target-blank": "error",
        "react/button-has-type": "error",
        "react/no-danger": "error",
        "react/jsx-no-useless-fragment": "error",
        "react/no-unknown-property": "error",
        "react/only-export-components": [
          "error",
          {
            "allowConstantExport": true,
            "allowExportNames": ["metadata", "viewport", "generateMetadata"]
          }
        ]
      }
    },
    {
      "files": ["**/*.stories.tsx"],
      "rules": {
        "typescript/no-floating-promises": "off"
      }
    },
    {
      // Console output is the purpose of CLI tools, scripts, and tests.
      "files": [
        "**/scripts/**",
        "tools/**",
        ".github/skills/**",
        "**/tests/**",
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "rules": {
        "eslint/no-console": "off"
      }
    },
    {
      // Tests throw plain objects to simulate Better Auth error payloads.
      "files": ["**/tests/**", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "typescript/only-throw-error": "off",
        "eslint/no-throw-literal": "off"
      }
    },
    {
      // Framework and non-app files that must export non-components:
      // TanStack file routes, TanStack Form createFormHook modules, React
      // context providers with their hooks, plugin factories with their slot
      // components, the HeroUI package barrel, Storybook fixtures, and tests.
      "files": [
        "apps/docs/src/routes/**",
        "apps/heroui-dev/src/routes/**",
        "examples/start-heroui-example/src/routes/**",
        "examples/start-shadcn-example/src/routes/**",
        "examples/start-shadcn-baseui-example/src/routes/**",
        "apps/docs/src/components/auth/auth-form.tsx",
        "examples/next-shadcn-example/src/components/auth/auth-form.tsx",
        "examples/start-shadcn-example/src/components/auth/auth-form.tsx",
        "examples/start-shadcn-baseui-example/src/components/auth/auth-form.tsx",
        "packages/heroui/src/components/auth/auth-form.tsx",
        "packages/react/src/components/auth/auth-provider.tsx",
        "packages/react/src/components/auth/fetch-options-provider.tsx",
        "packages/react/src/plugins/captcha-plugin.tsx",
        "packages/react/src/plugins/one-tap/one-tap-plugin.tsx",
        "packages/heroui/src/index.tsx",
        "examples/start-heroui-example/src/stories/support/**",
        "examples/start-shadcn-example/src/stories/support/**",
        "apps/docs/tests/**"
      ],
      "rules": {
        "react/only-export-components": "off"
      },
      "plugins": ["react"]
    }
  ]
}
