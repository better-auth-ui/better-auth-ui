# Better Auth
BETTER_AUTH_SECRET=

# Database (Neon Postgres)
DATABASE_URL=

# Social providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phone Verif (phone-verif.com) — server-side secrets, never exposed to the
# browser. Leave PHONE_VERIF_API_KEY empty to use the built-in mock provider.
PHONE_VERIF_API_KEY=
# Optional: enables signed webhooks at /api/phone-verification/webhook.
# Retrieve it once via `GET https://api.phone-verif.com/webhook-secret`.
PHONE_VERIF_WEBHOOK_SECRET=
