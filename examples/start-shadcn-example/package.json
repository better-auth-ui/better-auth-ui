{
  "name": "start-shadcn-example",
  "private": true,
  "type": "module",
  "nx": {
    "targets": {
      "registry:build": {
        "cache": true,
        "inputs": [
          "{projectRoot}/components.json",
          "{projectRoot}/package.json",
          "{projectRoot}/registry.metadata.json",
          "{projectRoot}/scripts/build-registry.ts",
          "{projectRoot}/scripts/registry-graph.ts",
          "{projectRoot}/src/**/*",
          "{workspaceRoot}/examples/start-shadcn-baseui-example/components.json",
          "{workspaceRoot}/examples/start-shadcn-baseui-example/package.json",
          "{workspaceRoot}/examples/start-shadcn-baseui-example/src/**/*",
          "{workspaceRoot}/packages/react/src/components/auth/email/**/*",
          "{workspaceRoot}/bun.lock",
          "typescript",
          "sharedGlobals"
        ],
        "outputs": [
          "{workspaceRoot}/apps/docs/public/r/base-*/*.json",
          "{workspaceRoot}/apps/docs/public/r/radix-*/*.json",
          "{workspaceRoot}/apps/docs/public/r/styles/base-*/*.json",
          "{workspaceRoot}/apps/docs/public/r/styles/radix-*/*.json"
        ]
      },
      "registry:test": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "^production",
          "{projectRoot}/registry.metadata.json",
          "{projectRoot}/scripts/registry-graph.ts",
          "{projectRoot}/tests/registry-graph.test.ts",
          "{projectRoot}/vitest.registry.config.ts",
          "{projectRoot}/src/**/*",
          "{workspaceRoot}/examples/start-shadcn-baseui-example/src/**/*",
          "{workspaceRoot}/packages/react/src/components/auth/email/**/*",
          "{workspaceRoot}/bun.lock",
          "typescript",
          "testEnvironment",
          "testToolchain",
          "sharedGlobals"
        ]
      }
    }
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "storybook": "storybook dev --config-dir .storybook --port 6006",
    "storybook:build": "storybook build --config-dir .storybook --output-dir storybook-static",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "registry:build": "bun scripts/build-registry.ts",
    "registry:test": "vitest run --config vitest.registry.config.ts tests/registry-graph.test.ts",
    "source:sync": "bash scripts/sync-consumers.sh"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.0",
    "@storybook/react-vite": "^10.5.10",
    "@tanstack/devtools-vite": "^0.8.3",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "^0.31.10",
    "storybook": "^10.5.10",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.9",
    "wrangler": "^4.119.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@better-auth-ui/core": "*",
    "@better-auth-ui/react": "*",
    "@better-auth/api-key": "1.7.2",
    "@better-auth/passkey": "1.7.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@marsidev/react-turnstile": "^1.5.5",
    "@neondatabase/serverless": "^1.0.2",
    "@react-email/render": "^2.0.9",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-devtools": "^0.10.9",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-pacer": "^0.23.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.21",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-store": "^0.11.1",
    "@tanstack/react-start": "^1.168.38",
    "@tanstack/react-table": "^9.2.4",
    "better-auth": "1.7.2",
    "bowser": "^2.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "drizzle-orm": "^0.45.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.29.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.4",
    "radix-ui": "^1.6.1",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-email": "^6.6.8",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.2"
  }
}
