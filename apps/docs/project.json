{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "dev": {
      "dependsOn": [
        "^dev",
        "email",
        "type-tables",
        {
          "projects": ["start-shadcn-example", "start-solid-zaidan-example"],
          "target": "registry:build"
        }
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "vite dev",
        "cwd": "apps/docs"
      },
      "continuous": true
    },
    "build": {
      "dependsOn": [
        "^build",
        "type-tables",
        "build-storybook-heroui",
        "build-storybook-shadcn",
        "build-storybook-zaidan",
        {
          "projects": ["start-shadcn-example", "start-solid-zaidan-example"],
          "target": "registry:build"
        }
      ],
      "inputs": [
        "default",
        "^default",
        {
          "dependentTasksOutputFiles": "apps/docs/public/**/*"
        }
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build",
        "cwd": "apps/docs"
      },
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck", "type-tables"],
      "executor": "nx:run-commands",
      "options": {
        "command": "fumadocs-mdx && tsr generate && tsc --noEmit",
        "cwd": "apps/docs"
      },
      "cache": true
    },
    "type-tables": {
      "executor": "nx:run-commands",
      "inputs": [
        "{workspaceRoot}/apps/docs/content/docs/**/*.mdx",
        "{workspaceRoot}/apps/docs/scripts/generate-type-tables.ts",
        "{workspaceRoot}/apps/docs/src/lib/type-table-data.ts",
        "{workspaceRoot}/apps/docs/package.json",
        "{workspaceRoot}/apps/docs/tsconfig.json",
        "{workspaceRoot}/examples/**/*.ts",
        "{workspaceRoot}/examples/**/*.tsx",
        "{workspaceRoot}/packages/**/*.ts",
        "{workspaceRoot}/packages/**/*.tsx",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/bun.lock"
      ],
      "options": {
        "command": "bun run type-tables:generate",
        "cwd": "apps/docs"
      },
      "outputs": ["{projectRoot}/type-table-snapshot.json"],
      "cache": true
    },
    "build-storybook-heroui": {
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "inputs": [
        "{workspaceRoot}/packages/core/src/**",
        "{workspaceRoot}/packages/core/package.json",
        "{workspaceRoot}/packages/react/src/**",
        "{workspaceRoot}/packages/react/package.json",
        "{workspaceRoot}/packages/heroui/src/**",
        "{workspaceRoot}/packages/heroui/package.json",
        "{workspaceRoot}/examples/start-heroui-example/package.json",
        "{workspaceRoot}/examples/start-heroui-example/.storybook/**",
        "{workspaceRoot}/examples/start-heroui-example/src/stories/**",
        "{workspaceRoot}/examples/start-heroui-example/src/styles/**",
        "{workspaceRoot}/apps/docs/scripts/build-storybook.ts",
        "{workspaceRoot}/bun.lock",
        {
          "dependentTasksOutputFiles": "packages/{core,react,heroui}/dist/**/*"
        }
      ],
      "options": {
        "command": "bun scripts/build-storybook.ts heroui",
        "cwd": "apps/docs"
      },
      "outputs": ["{projectRoot}/public/storybook/heroui"],
      "cache": true
    },
    "build-storybook-shadcn": {
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "inputs": [
        "{workspaceRoot}/packages/core/src/**",
        "{workspaceRoot}/packages/core/package.json",
        "{workspaceRoot}/packages/react/src/**",
        "{workspaceRoot}/packages/react/package.json",
        "{workspaceRoot}/examples/start-shadcn-example/package.json",
        "{workspaceRoot}/examples/start-shadcn-example/.storybook/**",
        "{workspaceRoot}/examples/start-shadcn-example/src/lib/**",
        "{workspaceRoot}/examples/start-shadcn-example/src/stories/**",
        "{workspaceRoot}/examples/start-shadcn-example/src/components/**",
        "{workspaceRoot}/examples/start-shadcn-example/src/styles/**",
        "{workspaceRoot}/apps/docs/scripts/build-storybook.ts",
        "{workspaceRoot}/bun.lock",
        {
          "dependentTasksOutputFiles": "packages/{core,react}/dist/**/*"
        }
      ],
      "options": {
        "command": "bun scripts/build-storybook.ts shadcn",
        "cwd": "apps/docs"
      },
      "outputs": ["{projectRoot}/public/storybook/shadcn"],
      "cache": true
    },
    "build-storybook-zaidan": {
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "inputs": [
        "{workspaceRoot}/packages/core/src/**",
        "{workspaceRoot}/packages/core/package.json",
        "{workspaceRoot}/packages/solid/src/**",
        "{workspaceRoot}/packages/solid/package.json",
        "{workspaceRoot}/examples/start-solid-zaidan-example/package.json",
        "{workspaceRoot}/examples/start-solid-zaidan-example/scripts/build-docs-storybook.ts",
        "{workspaceRoot}/examples/start-solid-zaidan-example/.storybook/**",
        "{workspaceRoot}/examples/start-solid-zaidan-example/src/lib/**",
        "{workspaceRoot}/examples/start-solid-zaidan-example/src/stories/**",
        "{workspaceRoot}/examples/start-solid-zaidan-example/src/components/**",
        "{workspaceRoot}/examples/start-solid-zaidan-example/src/routes/**",
        "{workspaceRoot}/bun.lock",
        {
          "dependentTasksOutputFiles": "packages/{core,solid}/dist/**/*"
        }
      ],
      "options": {
        "command": "bun ../../examples/start-solid-zaidan-example/scripts/build-docs-storybook.ts",
        "cwd": "apps/docs"
      },
      "outputs": ["{projectRoot}/public/storybook/zaidan"],
      "cache": true
    }
  }
}
